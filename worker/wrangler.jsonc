// Plot Speaks Worker.
//
// The unnamed top-level environment is DEV on purpose: a bare `npx wrangler deploy` can only
// ever reach plotspeaks-dev on workers.dev. Production exists only as the named env.prod and
// will be deployed through a script with its own pre-deploy checks.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plotspeaks-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "ENVIRONMENT": "dev" },
  "d1_databases": [
    { "binding": "DB", "database_name": "plotspeaks-dev", "database_id": "3c93a1ce-a864-405f-be55-01bd5ad3d565", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true },
  // Workers AI: cover images and submission moderation. Static files (logo, covers) in public/.
  "ai": { "binding": "AI" },
  "assets": { "directory": "public", "binding": "ASSETS" },
  // Daily 90-day log retention (scheduled() in src/index.ts -> src/retention.ts). Triggers are
  // per environment, so every env below repeats it. 03:23 UTC, off the hour.
  "triggers": { "crons": ["23 3 * * *"] },
  "env": {
    // Named dev env, so deploy commands can say --env=dev explicitly. Same Worker as the top level.
    "dev": {
      "name": "plotspeaks-dev",
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "dev" },
      "ai": { "binding": "AI" },
      "assets": { "directory": "public", "binding": "ASSETS" },
      "triggers": { "crons": ["23 3 * * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "plotspeaks-dev", "database_id": "3c93a1ce-a864-405f-be55-01bd5ad3d565", "migrations_dir": "migrations" }
      ]
    },
    // Production: plotspeaks.volocent.com. Deploy only through scripts/deploy-prod.ps1, which
    // builds the published catalog only, runs the checks and logs a D1 restore point first.
    // No DEV_ACCESS_KEY here: production is open to players.
    // ADMIN_KEY (a secret, never a var) unlocks /admin/* (review queue, cover generation); unset -> 404.
    "prod": {
      "name": "plotspeaks",
      "workers_dev": false,
      "routes": [{ "pattern": "plotspeaks.volocent.com", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "production" },
      "ai": { "binding": "AI" },
      "assets": { "directory": "public", "binding": "ASSETS" },
      "triggers": { "crons": ["23 3 * * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "plotspeaks", "database_id": "bf10cf37-6f31-4f7f-bf5d-e2366dd00518", "migrations_dir": "migrations" }
      ]
    }
  }
}
