// Plot Speaks Worker.
//
// The unnamed top-level environment is DEV on purpose: a bare `npx wrangler deploy` can only
// ever reach plotspeaks-dev on workers.dev. Production exists only as the named env.prod and
// will be deployed through a script with its own pre-deploy checks.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plotspeaks-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "ENVIRONMENT": "dev", "ACCOUNT_HOST": "account-dev.plotspeaks.com" },
  // Optional accounts: OAuth grants for the account connector (src/account.ts).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "ed1b61a6ca714580932f38f7f1c87e81" }],
  "routes": [{ "pattern": "dev.plotspeaks.com", "custom_domain": true }, { "pattern": "account-dev.plotspeaks.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "plotspeaks-dev", "database_id": "3c93a1ce-a864-405f-be55-01bd5ad3d565", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true },
  // Workers AI: cover images and submission moderation. Static files (logo, covers) in public/.
  // /audio/* runs the Worker first so the home page's sample can answer byte-range requests
  // (iOS Safari needs them to play audio); see serveAudio() in src/index.ts.
  "ai": { "binding": "AI" },
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/audio/*"] },
  // Daily 90-day log retention (scheduled() in src/index.ts -> src/retention.ts). Triggers are
  // per environment, so every env below repeats it. 03:23 UTC, off the hour.
  "triggers": { "crons": ["23 3 * * *"] },
  "env": {
    // Named dev env, so deploy commands can say --env=dev explicitly. Same Worker as the top level.
    "dev": {
      "name": "plotspeaks-dev",
      "workers_dev": true,
      "vars": { "ENVIRONMENT": "dev", "ACCOUNT_HOST": "account-dev.plotspeaks.com" },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "ed1b61a6ca714580932f38f7f1c87e81" }],
      // The account connector on dev, on its own host so dev mirrors prod.
      "routes": [{ "pattern": "dev.plotspeaks.com", "custom_domain": true }, { "pattern": "account-dev.plotspeaks.com", "custom_domain": true }],
      "ai": { "binding": "AI" },
      "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/audio/*"] },
      "triggers": { "crons": ["23 3 * * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "plotspeaks-dev", "database_id": "3c93a1ce-a864-405f-be55-01bd5ad3d565", "migrations_dir": "migrations" }
      ]
    },
    // Production: plotspeaks.com (plotspeaks.volocent.com redirects). Deploy only through scripts/deploy-prod.ps1, which
    // builds the published catalog only, runs the checks and logs a D1 restore point first.
    // No DEV_ACCESS_KEY here: production is open to players.
    // ADMIN_KEY (a secret, never a var) unlocks /admin/* (review queue, cover generation); unset -> 404.
    "prod": {
      "name": "plotspeaks",
      "workers_dev": false,
      "routes": [
        { "pattern": "plotspeaks.com", "custom_domain": true },
        { "pattern": "www.plotspeaks.com", "custom_domain": true },
        // The old address: pages redirect to plotspeaks.com; /mcp keeps answering for existing connectors.
        { "pattern": "plotspeaks.volocent.com", "custom_domain": true },
        // The connector with an account (optional sign-in). Its own host, so plotspeaks.com/mcp stays a
        // server with no sign-in and serves no OAuth metadata.
        { "pattern": "account.plotspeaks.com", "custom_domain": true }
      ],
      "vars": { "ENVIRONMENT": "production", "ACCOUNT_HOST": "account.plotspeaks.com" },
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "5ae9f7caeef14d809e71e9c49334ffb6" }],
      "ai": { "binding": "AI" },
      "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/audio/*"] },
      "triggers": { "crons": ["23 3 * * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "plotspeaks", "database_id": "bf10cf37-6f31-4f7f-bf5d-e2366dd00518", "migrations_dir": "migrations" }
      ]
    }
  }
}
